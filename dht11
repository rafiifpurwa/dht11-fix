#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include <ArduinoJson.h>
#include <DHT.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <time.h>

// ====== KONFIGURASI (sesuaikan dengan guide) ======
const char* WIFI_SSID      = "CirkitWifi";
const char* WIFI_PASS      = "";

const char* MQTT_SERVER    = "test.mosquitto.org";
const bool  USE_TLS        = true;   // false = tes tanpa TLS (untuk Cirkit)
const int   MQTT_PORT_TLS  = 8886;   // TLS (Let's Encrypt)
const int   MQTT_PORT_PLAIN= 1883;   // tanpa TLS
const char* MQTT_USER      = "";     // isi kalau broker butuh login
const char* MQTT_PASSWORD  = "";

const char* MQTT_TOPIC_PUB = "ionic/final/tim01/data";
const char* MQTT_TOPIC_SUB = "ionic/final/tim01/cmd";
const char* DEVICE_ID      = "esp32-tim01";

// Nama measurement InfluxDB (sesuaikan dengan guide)
const char* MEASUREMENT    = "sensor_data";

// Untuk verifikasi sertifikat penuh, isi ISRG Root X1 lalu pakai setCACert()
// const char* ROOT_CA = "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n";

// ====== PIN ======
#define DHT_PIN  12
#define DHT_TYPE DHT11
#define I2C_SDA  13
#define I2C_SCL  14

DHT dht(DHT_PIN, DHT_TYPE);
LiquidCrystal_I2C lcd(0x27, 16, 2);
WiFiClient plainClient;
WiFiClientSecure secureClient;
PubSubClient mqtt;

unsigned long lastPublish = 0;
const unsigned long PUBLISH_INTERVAL = 5000;
bool timeSynced = false;

// Baca DHT dengan percobaan ulang
bool readDHT(float &suhu, float &hum) {
  for (int i = 0; i < 3; i++) {
    suhu = dht.readTemperature();
    hum  = dht.readHumidity();
    if (!isnan(suhu) && !isnan(hum)) return true;
    delay(500);
  }
  return false;
}

void connectWiFi() {
  lcd.clear();
  lcd.print("Connect WiFi...");
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi connected: " + WiFi.localIP().toString());
  lcd.clear();
  lcd.print("WiFi OK");
}

// Sinkron waktu (NTP), maksimal ~10 detik supaya tidak macet
void syncTime() {
  configTime(7 * 3600, 0, "pool.ntp.org", "time.nist.gov");
  for (int i = 0; i < 20; i++) {
    if (time(nullptr) > 1700000000) { timeSynced = true; break; }
    delay(500);
  }
  Serial.println(timeSynced ? "Waktu NTP OK" : "NTP gagal, kirim tanpa timestamp");
}

// Callback saat ada pesan masuk (JSON)
void onMessage(char* topic, byte* payload, unsigned int length) {
  JsonDocument doc;
  DeserializationError err = deserializeJson(doc, payload, length);
  if (err) {
    Serial.println("JSON error: " + String(err.c_str()));
    return;
  }
  const char* cmd = doc["cmd"] | "";
  Serial.printf("Perintah diterima: %s\n", cmd);
  // TODO: aksi sesuai perintah, misal nyalakan LED/relay
}

void connectMQTT() {
  while (!mqtt.connected()) {
    Serial.print("Connect MQTT...");
    lcd.clear();
    lcd.print("Connect MQTT...");
    String clientId = String(DEVICE_ID) + "-" + String(random(0xffff), HEX);
    bool ok = (strlen(MQTT_USER) > 0)
                ? mqtt.connect(clientId.c_str(), MQTT_USER, MQTT_PASSWORD)
                : mqtt.connect(clientId.c_str());
    if (ok) {
      Serial.println("OK");
      mqtt.subscribe(MQTT_TOPIC_SUB);
      lcd.clear();
      lcd.print("MQTT OK");
    } else {
      Serial.printf("gagal rc=%d, coba lagi 2 detik\n", mqtt.state());
      delay(2000);
    }
  }
}

void setup() {
  Serial.begin(115200);

  // Pin I2C khusus, harus sebelum lcd.init()
  Wire.begin(I2C_SDA, I2C_SCL);
  lcd.init();
  lcd.backlight();

  dht.begin();
  delay(2000);  // beri waktu DHT11 siap setelah dapat daya

  connectWiFi();
  syncTime();

  if (USE_TLS) {
    secureClient.setInsecure();               // tes: tanpa verifikasi sertifikat
    // secureClient.setCACert(ROOT_CA);       // versi aman
    mqtt.setClient(secureClient);
    mqtt.setServer(MQTT_SERVER, MQTT_PORT_TLS);
  } else {
    mqtt.setClient(plainClient);
    mqtt.setServer(MQTT_SERVER, MQTT_PORT_PLAIN);
  }
  mqtt.setCallback(onMessage);
}

void loop() {
  if (WiFi.status() != WL_CONNECTED) connectWiFi();
  if (!mqtt.connected()) connectMQTT();
  mqtt.loop();

  if (millis() - lastPublish >= PUBLISH_INTERVAL) {
    lastPublish = millis();

    float suhu, hum;
    if (!readDHT(suhu, hum)) {
      Serial.printf("Gagal baca DHT11 di GPIO%d, cek VCC/GND/DATA\n", DHT_PIN);
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Sensor error");
      lcd.setCursor(0, 1);
      lcd.print("Cek kabel DHT");
      return;
    }

    // Tampil di LCD
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.printf("Suhu  : %.1f C", suhu);
    lcd.setCursor(0, 1);
    lcd.printf("Lembab: %.0f %%", hum);

    // Bentuk line protocol (InfluxDB) lalu publish
    char buffer[200];
    if (timeSynced) {
      unsigned long long ts = (unsigned long long)time(nullptr) * 1000000000ULL;
      snprintf(buffer, sizeof(buffer),
               "%s,device=%s temperature=%.1f,humidity=%.1f,rssi=%di %llu",
               MEASUREMENT, DEVICE_ID, suhu, hum, WiFi.RSSI(), ts);
    } else {
      snprintf(buffer, sizeof(buffer),
               "%s,device=%s temperature=%.1f,humidity=%.1f,rssi=%di",
               MEASUREMENT, DEVICE_ID, suhu, hum, WiFi.RSSI());
    }
    mqtt.publish(MQTT_TOPIC_PUB, buffer);
    Serial.println(buffer);
  }
}
